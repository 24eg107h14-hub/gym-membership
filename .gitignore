# =============================
# Maven / Spring Boot (Backend)
# =============================
gymMemberShip/target/
gymMemberShip/.mvn/wrapper/maven-wrapper.jar
*.jar
*.war
*.ear
*.class

# Maven wrapper (keep .mvn/wrapper/maven-wrapper.properties)
!gymMemberShip/.mvn/wrapper/maven-wrapper.properties

# Spring Boot application secrets — never commit real credentials
gymMemberShip/src/main/resources/application-secret.properties
gymMemberShip/.env
gymMemberShip/.env.*.local
# Uncomment the line below to stop tracking application.properties (recommended for production)
# gymMemberShip/src/main/resources/application.properties

